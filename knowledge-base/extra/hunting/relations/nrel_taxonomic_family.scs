nrel_taxonomic_family
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf: [принадлежит к таксономическому семейству] (* <- lang_ru;; *);
=> nrel_first_domain: concept_hunting_animal;
=> nrel_second_domain: concept_taxonomic_family;
=> nrel_definitional_domain: { concept_hunting_animal; concept_taxonomic_family };;
