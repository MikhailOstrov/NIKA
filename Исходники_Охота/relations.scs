/* Consolidated view of all hunting-domain relation definitions. */

/* Source: relations/nrel_activity_time.scs */

nrel_activity_time
<- sc_node_non_role_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf: [активен в период] (* <- lang_ru;; *);
=> nrel_first_domain: concept_hunting_animal;
=> nrel_second_domain: concept_hunting_season;
=> nrel_definitional_domain: { concept_hunting_animal; concept_hunting_season };
=> nrel_note: [Связывает животное с периодом, в котором наблюдается его активность; связь не исключает активность в другие сезоны.] (* <- lang_ru;; *);;

