concept_weapon <= nrel_inclusion: concept_hunting_object;;

/* Source: definitions.scs */

concept_phrase_unknown_hunting_habitat
=> nrel_note: [Класс статических ответов, сообщающих об отсутствии связи nrel_habitat в графе.] (* <- lang_ru;; *);;

sample_hunting_permit
=> nrel_note: [Абстрактный учебный экземпляр, не являющийся действующим разрешением.] (* <- lang_ru;; *);;

hare_tracks
=> nrel_note: [Учебный пример общего признака присутствия зайца.] (* <- lang_ru;; *);;

duck_call_sign
=> nrel_note: [Учебный пример голосового признака водоплавающей птицы.] (* <- lang_ru;; *);;

hunting_team
=> nrel_note: [Условный участник предметной модели без реальных персональных данных.] (* <- lang_ru;; *);;

shotgun_shell
=> nrel_note: [Обобщённый тип боеприпаса; параметры и порядок применения не рассматриваются.] (* <- lang_ru;; *);;

rifle_cartridge
=> nrel_note: [Обобщённый тип боеприпаса; параметры и порядок применения не рассматриваются.] (* <- lang_ru;; *);;

autumn_hunt_case
=> nrel_note: [Абстрактный пример для связей предметной области, не календарная рекомендация.] (* <- lang_ru;; *);;

elk
=> nrel_note: [Крупное лесное млекопитающее; в учебном графе связано с лесом и охотой с подхода.] (* <- lang_ru;; *);;

wild_boar
=> nrel_note: [Крупное млекопитающее; в учебном графе связано с лесом и загонной охотой.] (* <- lang_ru;; *);;

roe_deer
=> nrel_note: [Лесное млекопитающее; в учебном графе связано с охотой с подхода.] (* <- lang_ru;; *);;

red_deer
=> nrel_note: [Крупное млекопитающее; в учебном графе связано с лесным местообитанием.] (* <- lang_ru;; *);;

hare
=> nrel_note: [Небольшое млекопитающее; в учебном графе связано с полем и охотой по следу.] (* <- lang_ru;; *);;

fox
=> nrel_note: [Хищное млекопитающее; в учебном графе связано с лесом и засадой.] (* <- lang_ru;; *);;

duck
=> nrel_note: [Водоплавающая птица; в учебном графе связана с водоёмом и манком.] (* <- lang_ru;; *);;

goose
=> nrel_note: [Водоплавающая птица; в учебном графе связана с водоёмом и чучелом.] (* <- lang_ru;; *);;

stalking_hunt
=> nrel_note: [Метод охоты, основанный на осторожном приближении к объекту наблюдения.] (* <- lang_ru;; *);;

hunting_from_ambush
=> nrel_note: [Метод ожидания объекта в заранее выбранном укрытии.] (* <- lang_ru;; *);;

driven_hunt
=> nrel_note: [Коллективный метод с согласованными ролями участников и повышенными требованиями к безопасности.] (* <- lang_ru;; *);;

tracking_hunt
=> nrel_note: [Метод поиска по следам и другим признакам присутствия животного.] (* <- lang_ru;; *);;

bird_hunting
=> nrel_note: [Учебный класс методов наблюдения за птицами с применением подходящего снаряжения.] (* <- lang_ru;; *);;

hunting_with_dog
=> nrel_note: [Метод, при котором подготовленная собака помогает искать или обнаруживать объект.] (* <- lang_ru;; *);;

shotgun
=> nrel_note: [Гладкоствольное охотничье оружие; в учебном графе связано с охотой на птицу.] (* <- lang_ru;; *);;

rifle
=> nrel_note: [Нарезное охотничье оружие; в учебном графе связано с крупными млекопитающими.] (* <- lang_ru;; *);;

binoculars
=> nrel_note: [Оптический прибор для наблюдения на расстоянии.] (* <- lang_ru;; *);;

camouflage_clothing
=> nrel_note: [Одежда, помогающая уменьшить заметность наблюдателя.] (* <- lang_ru;; *);;

hunting_stand
=> nrel_note: [Оборудованное место ожидания, из которого ведётся наблюдение.] (* <- lang_ru;; *);;

radio_station
=> nrel_note: [Средство связи для согласования действий участников группы.] (* <- lang_ru;; *);;

compass
=> nrel_note: [Навигационный прибор для определения направления движения.] (* <- lang_ru;; *);;

duck_decoy
=> nrel_note: [Манок, используемый в учебном графе для привлечения внимания утки.] (* <- lang_ru;; *);;

bird_decoy
=> nrel_note: [Имитация птицы, используемая как визуальный ориентир.] (* <- lang_ru;; *);;

firearm_safety
=> nrel_note: [Комплекс правил безопасного обращения с оружием до, во время и после выхода.] (* <- lang_ru;; *);;

group_safety
=> nrel_note: [Правила согласования действий и безопасных направлений в группе.] (* <- lang_ru;; *);;

navigation_safety
=> nrel_note: [Правила сохранения маршрута, связи и ориентации на местности.] (* <- lang_ru;; *);;