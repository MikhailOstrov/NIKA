/* Consolidated view: concept definitions and explanatory notes. */

/* Source: concepts/concept_ammunition.scs */

concept_ammunition
<- sc_node_class;
<= nrel_inclusion: concept_hunting;
=> nrel_main_idtf: [охотничий боеприпас] (* <- lang_ru;; *);;

concept_ammunition
=> nrel_note: [Обобщённая категория боеприпасов без технических инструкций.] (* <- lang_ru;; *);;

/* Source: concepts/concept_bait.scs */

concept_bait
<- sc_node_class;
<= nrel_inclusion: concept_hunting;
=> nrel_main_idtf: [приманка и манок] (* <- lang_ru;; *);;

concept_bait
=> nrel_note: [Предмет или средство, применяемое для привлечения внимания животного.] (* <- lang_ru;; *);;

/* Source: concepts/concept_bird.scs */

concept_bird
<- sc_node_class;
<= nrel_inclusion: concept_hunting_animal;
=> nrel_main_idtf: [птица] (* <- lang_ru;; *);;

concept_bird
=> nrel_note: [Охотничье животное, относящееся к птицам.] (* <- lang_ru;; *);;

/* Source: concepts/concept_equipment.scs */

concept_equipment
<- sc_node_class;
<= nrel_inclusion: concept_hunting;
=> nrel_main_idtf: [охотничье снаряжение] (* <- lang_ru;; *);;

concept_equipment
=> nrel_note: [Снаряжение, помогающее наблюдать, перемещаться и поддерживать безопасность.] (* <- lang_ru;; *);;

concept_equipment <= nrel_inclusion: concept_hunting_object;;

/* Source: concepts/concept_forest_game_bird.scs */

concept_forest_game_bird <- sc_node_class;
<= nrel_inclusion: concept_bird;
=> nrel_main_idtf: [боровая охотничья птица] (* <- lang_ru;; *);
=> nrel_note: [Учебная группа боровой дичи, включая глухаря, тетерева, рябчика и вальдшнепа; источник: Белгосохота, с. 7.] (* <- lang_ru;; *);;

/* Source: concepts/concept_habitat.scs */

concept_habitat
<- sc_node_class;
<= nrel_inclusion: concept_hunting;
=> nrel_main_idtf: [место обитания] (* <- lang_ru;; *);;

concept_habitat
=> nrel_note: [Тип природного места, в котором обычно наблюдается животное.] (* <- lang_ru;; *);;

/* Source: concepts/concept_hunting.scs */

concept_hunting
<- sc_node_class;
=> nrel_main_idtf:
    [охота]
    (* <- lang_ru;; *);
    [hunting]
    (* <- lang_en;; *);
=> nrel_note:
    [Учебная предметная область о видах охоты, животных, снаряжении, методах, местах обитания и безопасности.]
    (* <- lang_ru;; *);;

concept_hunting
=> nrel_note: [Система понятий о подготовке, проведении и безопасном сопровождении охоты.] (* <- lang_ru;; *);;

/* Source: concepts/concept_hunting_animal.scs */

concept_hunting_animal
<- sc_node_class;
<= nrel_inclusion: concept_hunting;
=> nrel_main_idtf:
    [охотничье животное]
    (* <- lang_ru;; *);;

concept_hunting_animal
=> nrel_note: [Животное, рассматриваемое как объект наблюдения или охотничьей деятельности.] (* <- lang_ru;; *);;

