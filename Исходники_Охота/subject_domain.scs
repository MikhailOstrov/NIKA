/* Source: concepts/concept_hunting_ungulate.scs */

/* Учебные сведения по материалам Белгосохоты, PDF 2026 года.
   Номера в примечаниях — страницы предоставленного пользователем PDF.
   Периоды размножения животных не являются сроками разрешённой охоты. */

concept_hunting_ungulate <- sc_node_class;
<= nrel_inclusion: concept_mammal;
=> nrel_main_idtf: [копытное охотничье животное] (* <- lang_ru;; *);
=> nrel_note: [Учебная группа копытных охотничьих животных; источник: Белгосохота, с. 7.] (* <- lang_ru;; *);;

